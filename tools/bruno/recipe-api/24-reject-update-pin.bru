meta {
  name: Reject pin in update
  type: http
  seq: 24
}

put {
  url: {{baseUrl}}/recipes/{{recipeId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "  Bruno cheese omelette  ",
    "ingredients": [
      {
        "name": " cheese ",
        "quantity": " 50 ",
        "unit": " g "
      }
    ],
    "instructions": [
      " Fold gently. "
    ],
    "isWorkInProgress": true,
    "isPinned": true
  }
}

script:pre-request {
  if (!bru.getVar("recipeId")) throw new Error("Run Create recipe first.");
}

tests {
  test("Returns 400", () => {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ message: "Invalid recipe" });
  });
}
