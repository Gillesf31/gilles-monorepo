meta {
  name: Hello
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/hello
  body: none
  auth: none
}

tests {
  test("Hello endpoint is reachable", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.include("text/plain");
    expect(res.getBody()).to.equal("Hello World");
  });
}
