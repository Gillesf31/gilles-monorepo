meta {
  name: Reject missing pin status
  type: http
  seq: 32
}

patch {
  url: {{baseUrl}}/recipes/{{recipeId}}/pin
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  if (!bru.getVar("updatedRecipe") || bru.getVar("updatedRecipe").id !== bru.getVar("recipeId")) throw new Error("Run Create recipe and Update recipe first.");
}

tests {
  test("Returns 400", () => {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ message: "Invalid pin status" });
  });
}
