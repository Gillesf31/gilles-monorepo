meta {
  name: Pin malformed ID
  type: http
  seq: 37
}

patch {
  url: {{baseUrl}}/recipes/1/pin
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "isPinned": true
  }
}

tests {
  test("Returns 404", () => {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody()).to.deep.equal({ message: "Recipe not found" });
  });
}
