meta {
  name: Delete recipe again
  type: http
  seq: 30
}

delete {
  url: {{baseUrl}}/recipes/{{recipeId}}
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("createdRecipe") || bru.getVar("createdRecipe").id !== bru.getVar("recipeId")) throw new Error("Run the collection creation request before deleting its sample.");
}

tests {
  test("Returns 404", () => {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody()).to.deep.equal({ message: "Recipe not found" });
  });
}
