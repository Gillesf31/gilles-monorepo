meta {
  name: Verify deleted recipes absent
  type: http
  seq: 35
}

get {
  url: {{baseUrl}}/recipes
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("recipeId")) throw new Error("Run Create recipe first.");
  if (!bru.getVar("draftRecipeId")) throw new Error("Run Create draft first.");
}

tests {
  test("Neither collection sample remains in the database", () => {
    expect(res.getStatus()).to.equal(200);
    const ids = res.getBody().map((recipe) => recipe.id);
    expect(ids).not.to.include(bru.getVar("recipeId"));
    expect(ids).not.to.include(bru.getVar("draftRecipeId"));
  });
}
