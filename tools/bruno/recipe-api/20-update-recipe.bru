meta {
  name: Update recipe
  type: http
  seq: 20
}

put {
  url: {{baseUrl}}/recipes/{{recipeId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "  Bruno cheese omelette  ",
    "ingredients": [
      {
        "name": " cheese ",
        "quantity": " 50 ",
        "unit": " g "
      }
    ],
    "instructions": [
      " Fold gently. "
    ],
    "isWorkInProgress": true
  }
}

script:pre-request {
  if (!bru.getVar("recipeId")) throw new Error("Run Create recipe first.");
  bru.setVar("updatedRecipe", null);
}

tests {
  test("Replaces content and preserves the ID and pin", () => {
    expect(res.getStatus()).to.equal(200);
    const recipe = res.getBody();
    expect(recipe).to.deep.equal({
      id: bru.getVar("recipeId"), title: "Bruno cheese omelette",
      ingredients: [{ name: "cheese", quantity: "50", unit: "g" }],
      instructions: ["Fold gently."], isWorkInProgress: true,
      isPinned: bru.getVar("createdRecipe").isPinned
    });
    bru.setVar("updatedRecipe", recipe);
  });
}
