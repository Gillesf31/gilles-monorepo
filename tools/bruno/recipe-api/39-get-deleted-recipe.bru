meta {
  name: Get deleted recipe
  type: http
  seq: 39
}

get {
  url: {{baseUrl}}/recipes/{{recipeId}}
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("recipeId")) throw new Error("Run Create recipe first.");
}

tests {
  test("Returns 404", () => {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody()).to.deep.equal({ message: "Recipe not found" });
  });
}
